# =============================================================================
# Reverie Environment Configuration
# =============================================================================
# Copy this file to .env and configure for your deployment.
# DO NOT commit .env to version control!
# =============================================================================

# =============================================================================
# Django Settings
# =============================================================================

# Generate a secure secret key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-in-production

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hosts
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL connection (for production)
DB_NAME=reverie
DB_USER=reverie
DB_PASSWORD=your-secure-password
DB_HOST=db
DB_PORT=5432

# Alternative: use DATABASE_URL (takes precedence over individual DB_ variables)
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE (or postgresql://)
# Example: DATABASE_URL=postgres://reverie:password@localhost:5432/reverie

# =============================================================================
# OpenAI API Configuration
# =============================================================================

# Your OpenAI API key (required for LLM functionality)
OPENAI_API_KEY=sk-your-api-key-here

# Key owner for tracking
KEY_OWNER=YourName

# Model selection
OPENAI_CHAT_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# =============================================================================
# TextGen Fallback (Local LLM)
# =============================================================================

# Enable local LLM fallback (set to True if not using OpenAI)
ENABLE_TEXTGEN_FALLBACK=False

# TextGen server URL (if using local LLM)
TEXTGEN_MODEL_URL=http://localhost:5000

# Local embedding model
REVERIE_EMBEDDING_MODEL=BAAI/bge-small-en
REVERIE_EMBEDDING_DEVICE=cpu

# =============================================================================
# Redis Configuration
# =============================================================================

REDIS_URL=redis://redis:6379/0

# =============================================================================
# API Security
# =============================================================================

# Enable API authentication
REQUIRE_API_AUTH=True

# Comma-separated list of valid API keys
API_KEYS=your-api-key-1,your-api-key-2

# CORS settings
CORS_ALLOW_ALL=False
CORS_ALLOWED_ORIGINS=https://your-frontend.com

# =============================================================================
# Simulation Settings
# =============================================================================

# Enable debug output
REVERIE_DEBUG=False

# API call settings
MAX_API_RETRIES=3
API_CALL_DELAY=0.1

# =============================================================================
# Logging
# =============================================================================

LOG_FILE=/var/log/reverie/django.log

# =============================================================================
# SSL/Security (for production)
# =============================================================================

SECURE_SSL_REDIRECT=True

# =============================================================================
# Storage Paths (override defaults)
# =============================================================================

# SIMULATION_STORAGE_PATH=/path/to/storage
# TEMP_STORAGE_PATH=/path/to/temp_storage
# COMPRESSED_STORAGE_PATH=/path/to/compressed_storage
